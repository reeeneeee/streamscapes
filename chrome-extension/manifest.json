{
  "manifest_version": 3,
  "name": "Streamscapes",
  "version": "0.3.0",
  "description": "Stream browser activity to Streamscapes",
  "permissions": ["tabs", "downloads", "storage"],
  "host_permissions": ["https://www.streamscapes.fm/*", "http://localhost:3000/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
