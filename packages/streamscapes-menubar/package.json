{
  "name": "streamscapes-menubar",
  "version": "0.1.0",
  "description": "Streamscapes Agent — macOS menu bar app for streaming notifications and Datadog traces",
  "main": "dist/main.js",
  "scripts": {
    "build:ts": "node build.mjs",
    "start": "npm run build:ts && electron dist/main.js",
    "dist": "npm run build:ts && electron-builder --mac"
  },
  "devDependencies": {
    "esbuild": "^0.27.3",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.streamscapes.agent",
    "productName": "Streamscapes Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        }
      ],
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "sign": false
    }
  }
}
