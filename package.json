{
  "name": "streamscapes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:bridge": "esbuild src/lib/audio-bridge.ts --bundle --format=iife --target=es2017 --outfile=StreamscapesiOS/Sources/Resources/audio-bridge.js --minify",
    "build:agent": "echo '#!/usr/bin/env node' > packages/streamscapes-agent/bin/agent.js && npx esbuild scripts/agent.ts --bundle --platform=node --target=node18 --format=cjs | tail -n +2 >> packages/streamscapes-agent/bin/agent.js && chmod +x packages/streamscapes-agent/bin/agent.js",
    "build:menubar": "cd packages/streamscapes-menubar && node build.mjs"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.1",
    "@neondatabase/serverless": "^1.0.2",
    "@upstash/redis": "^1.37.0",
    "drizzle-orm": "^0.45.1",
    "jose": "^6.2.1",
    "next": "^15.5.12",
    "next-auth": "^5.0.0-beta.30",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tonal": "^6.4.0",
    "tone": "^15.0.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.9",
    "esbuild": "^0.27.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
